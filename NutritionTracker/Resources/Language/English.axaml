    <x:String x:Key="FiberTitle">Fiber</x:String>
    <x:String x:Key="FiberInfo">
        
    </x:String>

    <x:String x:Key="FatTitle">Fats and Cholesterol</x:String>
    <x:String x:Key="FatInfo">
        
    </x:String>

  <x:String x:Key="MicroNutrientsTitle">Micronutrients</x:String>

    
</ResourceDictionary>
