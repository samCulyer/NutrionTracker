<ResourceDictionary xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String x:Key="Title">Nutrition Tracker</x:String>

    <!--SidePanel-->

