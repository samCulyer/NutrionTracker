    <x:String x:Key="CaloriesTitle">Calories</x:String>
    <x:String x:Key="CaloriesInfo">
        
    </x:String>

    <x:String x:Key="ProteinTitle">Protein</x:String>
    <x:String x:Key="ProteinInfo">
        Protein is an essential macronutrient.
    </x:String>

    <x:String x:Key="CarbohydratesTitle">Carbohydrates</x:String>
    <x:String x:Key="CarbohydratesInfo">
        
    </x:String>

    <x:String x:Key="FiberTitle">Fiber</x:String>
    <x:String x:Key="FiberInfo">
        
    </x:String>

