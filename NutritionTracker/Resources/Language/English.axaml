    <x:String x:Key="VitaminB6Title">Vitamin B6 (pyridoxal)</x:String>
    <x:String x:Key="VitaminB7Title">Vitamin B7 (Biotin)</x:String>
    <x:String x:Key="VitaminB9Title">Vitamin B9 (Folic acid)</x:String>
    <x:String x:Key="VitaminB12Title">Vitamin B12</x:String>
    <x:String x:Key="VitaminCTitle">Vitamin C</x:String>
    <x:String x:Key="CholineTitle">Choline</x:String>
