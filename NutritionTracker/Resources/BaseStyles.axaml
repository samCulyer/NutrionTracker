<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <!-- Add Controls for Previewer Here -->
    </Border>
  </Design.PreviewWith>

	<Styles.Resources>
		<ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
              <MergeResourceInclude Source="avares://NutritionTracker/Resources/Themes.axaml" />
            </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
	</Styles.Resources>

	<Style Selector="Border.window">
		<Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
	</Style>

	<Style Selector="ProgressBar">
		<Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
		<Setter Property="Height" Value="12"/>
		<Setter Property="Margin" Value="10"/>
		<Setter Property="ShowProgressText" Value="True"/>
		<Setter Property="FontSize" Value="10"/>
	</Style>

	<Style Selector="Button.window-close">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding" Value="4"/>
		<Setter Property="Margin" Value="0,0,0,0"/>
		<Setter Property="CornerRadius" Value="0,0,0,0"/>
		<Setter Property="Width" Value="30"/>
		<Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
		</Style>
	</Style>

	<Style Selector="Button.window-minmax">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding" Value="4"/>
		<Setter Property="CornerRadius" Value="0,0,0,0"/>
		<Setter Property="Margin" Value="0,0,0,0"/>
		<Setter Property="Width" Value="30"/>
		<Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource MinMaxHoverBrush}"/>
		</Style>
	</Style>

	<Style Selector="Image.icon">
		<Setter Property="Width" Value="24"/>
		<Setter Property="Height" Value="24"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
	</Style>
	
	<Style Selector="Border.separator">
		<Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
		<Setter Property="Margin" Value="10"/>
		<Setter Property="CornerRadius" Value="5"/>
	</Style>

	<Style Selector="Expander">
		<Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="IsExpanded" Value="True"/>
		<Setter Property="BorderThickness" Value="0,0,3,3"/>
		<Setter Property="Padding" Value="5"/>
	</Style>

	<Style Selector="ContentControl.panel">
		<Setter Property="Template">
        <ControlTemplate>
            <Border Margin="5,5,0,0"
					Padding="-5,-5,0,0"
                    Background="{DynamicResource PanelBorderBrush}"
					CornerRadius="{TemplateBinding CornerRadius}"
                    BorderThickness="0">
                
                <Border Margin="0,0,5,5"
						BorderThickness="0"
                        Background="{DynamicResource PanelBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
						CornerRadius="{TemplateBinding CornerRadius}"
						Padding="{TemplateBinding Padding}">
					
					<ContentPresenter Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"/>
                </Border>
            </Border>
        </ControlTemplate>
		</Setter>
	</Style>

</Styles>
