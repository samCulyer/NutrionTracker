<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NutritionTracker.MainWindow"
        xmlns:data="using:NutritionTracker.Data"
        x:DataType="data:DataStore"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="32"
        PropertyChanged="MainWindow_PropertyChanged"
        Background="Transparent" FontSize="{Binding FontSize}">
    <Border Name="WindowBorder" CornerRadius="5" ClipToBounds="True" Classes="window">

        <Grid RowDefinitions="Auto,*" >

            <Grid Name="TitleBarGrid" Height="24" ColumnDefinitions="Auto,*,Auto" 
                  PointerPressed="TitleBar_PointerPressed" Background="Transparent">

                <TextBlock Grid.Column="1" VerticalAlignment="Center" 
                    HorizontalAlignment="Center" Text="{DynamicResource Title}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Click="Minimize_Click" DockPanel.Dock="Right" Classes="window-minmax">
                        <Image Source="{DynamicResource MinimizeIcon}"/>
                    </Button>
                    <Button Click="Maximize_Click" DockPanel.Dock="Right" Classes="window-minmax">
						<Image Source="{DynamicResource MaximizeIcon}"/>
                    </Button>
                    <Button Click="Close_Click" DockPanel.Dock="Right" Classes="window-close">
						<Image Source="{DynamicResource CloseIcon}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <SplitView Grid.Row="1" x:Name="SideMenu_SplitView" DisplayMode="CompactInline" IsPaneOpen="True" 
                       OpenPaneLength="180" CompactPaneLength="48" PaneBackground="Transparent" Margin="0,0,0,10" >
				<SplitView.Pane>
                    <Border BorderBrush="{DynamicResource SystemAccentColor}" Background="{DynamicResource PaneBrush}"
                             BorderThickness="0,0,2,2"
                            CornerRadius="0,5,5,0">
                        <StackPanel>
						<Button Click="PaneState_Click" Margin="10,10,0,0" Padding="5" Width="28">
							<Image Source="{DynamicResource BurgerIcon}" Width="19" Height="19"/>
                        </Button>

				        <TabStrip SelectionChanged="OnTabSelectionChanged">
                            <TabStrip.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                        </TabStrip.ItemsPanel>
			                <TabStripItem Tag="UserTab">
								<StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="{DynamicResource MinimizeIcon}" Classes="icon"/>
                                    <TextBlock Text="Profile" IsVisible="{Binding #SideMenu_SplitView.IsPaneOpen}"/>
                                </StackPanel>
                            </TabStripItem>
			                <TabStripItem Tag="FoodLogTab">
								<StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="{DynamicResource MinimizeIcon}" Classes="icon"/>
                                    <TextBlock Text="Food Log" IsVisible="{Binding #SideMenu_SplitView.IsPaneOpen}"/>
                                </StackPanel>
                            </TabStripItem>
			                <TabStripItem Tag="InsightsTab">
								<StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="{DynamicResource MinimizeIcon}" Classes="icon"/>
                                    <TextBlock Text="Insights" IsVisible="{Binding #SideMenu_SplitView.IsPaneOpen}"/>
                                </StackPanel>
                            </TabStripItem>
			                <TabStripItem Tag="RecipesTab">
								<StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="{DynamicResource MinimizeIcon}" Classes="icon"/>
                                    <TextBlock Text="Recipes" IsVisible="{Binding #SideMenu_SplitView.IsPaneOpen}"/>
                                </StackPanel>
                            </TabStripItem>
			                <TabStripItem Tag="InfoTab">
								<StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="{DynamicResource MinimizeIcon}" Classes="icon"/>
                                    <TextBlock Text="Info" IsVisible="{Binding #SideMenu_SplitView.IsPaneOpen}"/>
                                </StackPanel>
                            </TabStripItem>
			                <TabStripItem Tag="SettingsTab">
								<StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="{DynamicResource MinimizeIcon}" Classes="icon"/>
                                    <TextBlock Text="Settings" IsVisible="{Binding #SideMenu_SplitView.IsPaneOpen}"/>
                                </StackPanel>
                            </TabStripItem>
			                <TabStripItem Tag="AboutTab">
								<StackPanel Orientation="Horizontal" Spacing="10">
                                    <Image Source="{DynamicResource MinimizeIcon}" Classes="icon"/>
                                    <TextBlock Text="About" IsVisible="{Binding #SideMenu_SplitView.IsPaneOpen}"/>
                                </StackPanel>
                            </TabStripItem>
                        </TabStrip>
                    </StackPanel>
						
                    </Border>
                </SplitView.Pane>

                <ContentControl Grid.Column="2" Margin="10,0" Name="ContentView"/>
            </SplitView>
			
        </Grid>
    </Border>
</Window>
